+test "Page reduced Google fixture defers native Enter submit until keypress" {
+    var page = try testing.pageTest("page/google_home_title_probe.html");
+    defer page._session.removePage();
+
+    _ = page._session.wait(200);
+
+    _ = try page.triggerKeyboardKeyDownNoTextWithCodeAndRepeat("n", "KeyN", .{}, false);
+    _ = try page.triggerKeyboardKeyPressWithCode("n", "KeyN", .{}, false);
+    try page.insertText("n");
+
+    page.beginDeferredNativeTextInputEnterSubmit();
+    defer page.endDeferredNativeTextInputEnterSubmit();
+
+    _ = try page.triggerKeyboardKeyDownNoTextWithCodeAndRepeat("Enter", "Enter", .{}, false);
+
+    const keydown_title = (try page.getTitle()) orelse return error.TestTitleMissing;
+    try testing.expect(std.mem.startsWith(u8, keydown_title, "KEYDOWN:n|"));
+
+    _ = try page.triggerKeyboardKeyPressWithCode("Enter", "Enter", .{}, false);
+    try page.applyDeferredNativeTextInputEnterSubmit();
+
+    const submit_title = (try page.getTitle()) orelse return error.TestTitleMissing;
+    try testing.expect(std.mem.startsWith(u8, submit_title, "SUBMIT:n|"));
+}
