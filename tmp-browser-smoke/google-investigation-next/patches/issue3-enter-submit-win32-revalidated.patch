+fn makeTextInputEvent(bytes: []const u8) ?Win32Backend.TextInputEvent {
+    if (bytes.len == 0 or bytes.len > 4) {
+        return null;
+    }
+
+    var text_input: Win32Backend.TextInputEvent = .{
+        .bytes = undefined,
+        .len = @intCast(bytes.len),
+    };
+    @memcpy(text_input.bytes[0..bytes.len], bytes);
+    return text_input;
+}
+
+fn textInputEventMatches(expected: Win32Backend.TextInputEvent, actual: []const u8) bool {
+    return expected.len == actual.len and std.mem.eql(u8, expected.bytes[0..expected.len], actual);
+}
+
+fn queuePendingTextInputSuppression(self: *Win32Backend, bytes: []const u8) void {
+    const text_input = makeTextInputEvent(bytes) orelse return;
+    self.pending_text_input_suppressions.append(self.allocator, text_input) catch {};
+}
+
+fn shouldSuppressPendingTextInput(self: *Win32Backend, bytes: []const u8) bool {
+    const items = self.pending_text_input_suppressions.items;
+    if (items.len == 0) {
+        return false;
+    }
+
+    for (items, 0..) |expected, idx| {
+        if (textInputEventMatches(expected, bytes)) {
+            const remaining = items[(idx + 1)..];
+            std.mem.copyForwards(Win32Backend.TextInputEvent, items[0..remaining.len], remaining);
+            self.pending_text_input_suppressions.items.len = remaining.len;
+            return true;
+        }
+    }
+
+    self.pending_text_input_suppressions.clearRetainingCapacity();
+    return false;
+}
